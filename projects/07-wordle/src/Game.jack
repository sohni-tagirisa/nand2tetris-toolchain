// By Sohni Tagirisa
// main game class that handles all wordle game logic
class Game {
    // static variables shared across all game instances for screen display
    static int ROWS, WORD_LEN, CELL_W, CELL_H, GRID_X, GRID_Y, LEVEL_COUNT;
    static String TITLE, MSG1, MSG2, MSG3, MSG4, NEXT_MSG, EXIT_MSG;

    // instance variables for current game state
    field String secret; // the word the player needs to guess
    field Array guesses; // array storing all the player's guesses (as char arrays, not Strings)
    field Array results; // array storing correctness of each guess
    field int row; // current row/guess number (0-5)
    field int level; // current level number
    field int wins; // total wins across all levels
    field int losses; // total losses across all levels
    field Array inputChars; // reusable array for input characters
    field Array charCount; // reusable array for counting chars in score()

    // constructor initializes the game with all settings and arrays
    constructor Game new() {
        // set up grid dimensions and layout
        let ROWS = 6;
        let WORD_LEN = 5;
        let CELL_W = 40;
        let CELL_H = 30;
        let GRID_X = 40;
        let GRID_Y = 24;
        let LEVEL_COUNT = WordList.size();

        // initialize game state variables
        let row = 0;
        let level = 0;
        let secret = null;
        let wins = 0;
        let losses = 0;

        // create reusable input buffer
        let inputChars = Array.new(WORD_LEN);

        // create reusable character counting array
        let charCount = Array.new(26);

        // create arrays to store guesses and results
        let guesses = Array.new(ROWS);
        let results = Array.new(ROWS);
        do initArrays();

        return this;
    }

    // clean up all memory allocations when game ends
    method void dispose() {
        var int i;
        var Array a;
        let i = 0;

        // free each guess array
        while (i < ROWS) {
            let a = guesses[i];
            if (~(a = null)) {
                do Memory.deAlloc(a);
            }
            let a = results[i];
            if (~(a = null)) {
                do Memory.deAlloc(a);
            }
            let i = i + 1;
        }

        // free the input buffer and char count array
        if (~(inputChars = null)) {
            do Memory.deAlloc(inputChars);
        }
        if (~(charCount = null)) {
            do Memory.deAlloc(charCount);
        }

        // free the guesses and results arrays
        do Memory.deAlloc(guesses);
        do Memory.deAlloc(results);
        do Memory.deAlloc(this);
        return;
    }

    // main game loop that runs all levels and handles restarts
    method void run() {
        var boolean done;
        var Array gline;
        var Array res;
        var boolean gameActive;

        let gameActive = true;
        // show intro only once at the very beginning
        do WordList.showIntro();

        // outer loop allows game to restart
        while (gameActive) {
            let level = 0;
            let wins = 0;
            let losses = 0;
            do startLevel();

            // loop through all 10 levels
            while (level < LEVEL_COUNT) {
                let done = false;

                // loop for up to 6 guesses per level
                while ((~done) & (row < ROWS)) {
                    do readGuess(); // get player input into inputChars
                    let res = score(inputChars); // check if correct and how many letters match

                    // Copy inputChars to guesses[row]
                    let gline = guesses[row];
                    do Util.copyArray(inputChars, gline, WORD_LEN);

                    do drawRow(row, gline, res); // display the guess on screen

                    // check if player guessed the word correctly
                    if (arrEqStr(gline, secret)) {
                        do drawWin(row);
                        let wins = wins + 1;
                        let done = true;
                    } else {
                        let row = row + 1; // move to next guess if wrong
                    }
                }

                // if player used all 6 guesses without winning
                if ((~done) & (row = ROWS)) {
                    do drawLose();
                    let losses = losses + 1;
                }

                let level = level + 1;
                // if more levels remain, show stats and start next level
                if (level < LEVEL_COUNT) {
                    let row = 0;
                    do showStatsScreen();
                    do startLevel();
                } else {
                    // all levels complete - show final screen
                    let gameActive = endPrompt();
                }
            }
        }
        return;
    }

    // compare an array of chars to a string
    method boolean arrEqStr(Array arr, String str) {
        var int i;
        let i = 0;
        while (i < WORD_LEN) {
            if (~(arr[i] = str.charAt(i))) {
                return false;
            }
            let i = i + 1;
        }
        return true;
    }

    // initialize the arrays with empty/zero values
    method void initArrays() {
        var int r;
        var Array a;

        let r = 0;
        while (r < ROWS) {
            // create array for guess characters
            let a = Array.new(WORD_LEN);
            do Util.fillInt(a, WORD_LEN, 0);
            let guesses[r] = a;

            // create a new array for each row of results
            let a = Array.new(WORD_LEN);
            do Util.fillInt(a, WORD_LEN, 0);
            let results[r] = a;
            let r = r + 1;
        }
        return;
    }

    // reset all storage arrays and reuse them for the next level
    method void resetStorage() {
        var int i;
        var int j;
        var Array a;

        // clear guess arrays, set to space character (32) not 0
        let i = 0;
        while (i < ROWS) {
            let a = guesses[i];
            let j = 0;
            while (j < WORD_LEN) {
                let a[j] = 32;  // space character
                let j = j + 1;
            }
            let i = i + 1;
        }

        // clear result values
        let i = 0;
        while (i < ROWS) {
            let a = results[i];
            let j = 0;
            while (j < WORD_LEN) {
                let a[j] = 0;
                let j = j + 1;
            }
            let i = i + 1;
        }

        let row = 0;
        return;
    }

    // start a new level with a fresh secret word
    method void startLevel() {
        do resetStorage();
        // get the secret word for this level using the level number as index
        let secret = WordList.pick(level);

        // clear screen and draw title + grid every level to keep the level label visible
        do Screen.clearScreen();
        do drawTitle();
        do drawEmptyGrid();

        return;
    }

    // read player input until they enter a 5 letter word
    // stores result in inputChars array
    method void readGuess() {
        var int c;
        var int k;

        // clear input buffer
        do Util.fillInt(inputChars, WORD_LEN, 0);
        let k = 0;
        do renderPrompt(k);

        // keep reading characters until player presses enter with 5 letters
        while (true) {
            // move cursor off-screen and read character
            do hideCursor();
            let c = Keyboard.readChar();
            do hideCursor();

            // convert lowercase letters to uppercase
            if ((c > 96) & (c < 123)) {
                let c = c - 32;
            }

            // if letter key pressed and space available, add to guess
            if ((c > 64) & (c < 91)) {
                if (k < WORD_LEN) {
                    let inputChars[k] = c;
                    let k = k + 1;
                    // display typed letter in the grid cell
                    do drawCell(row, k - 1, 0, c);
                }
            }

            // backspace key, remove last character if any
            if ((c = 129) & (k > 0)) {
                let k = k - 1;
                let inputChars[k] = 0;
                // clear the erased cell in the grid
                do drawCell(row, k, 0, 32);
            }

            do renderPrompt(k);

            // enter key: submit guess if exactly 5 letters entered
            if ((c = 128) & (k = WORD_LEN)) {
                do renderPrompt(k);
                return;
            }
        }
        return;
    }

    // score the guess by checking which letters are correct or in wrong spot
    method Array score(Array g) {
        var Array res; // result array (0=wrong, 1=wrong spot, 2=correct spot)
        var int i;
        var int ch;

        let res = results[row];

        // use reusable charCount array instead of allocating new one
        // initialize arrays to 0
        do Util.fillInt(res, WORD_LEN, 0);
        do Util.fillInt(charCount, 26, 0);

        // count frequency of each letter in secret word
        let i = 0;
        while (i < WORD_LEN) {
            let ch = secret.charAt(i) - 65;
            let charCount[ch] = charCount[ch] + 1;
            let i = i + 1;
        }

        // mark exact matches (correct letter in correct position)
        let i = 0;
        while (i < WORD_LEN) {
            if (g[i] = secret.charAt(i)) {
                let res[i] = 2;  // exact match
                let ch = g[i] - 65;
                let charCount[ch] = charCount[ch] - 1;  // decrement count
            }
            let i = i + 1;
        }

        // mark wrong spot matches (correct letter in wrong position)
        let i = 0;
        while (i < WORD_LEN) {
            if (res[i] = 0) {  // if not already marked as exact
                let ch = g[i] - 65;
                if (charCount[ch] > 0) {  // if letter still available
                    let res[i] = 1;  // wrong spot
                    let charCount[ch] = charCount[ch] - 1;
                }
            }
            let i = i + 1;
        }

        // no need to deallocate, we reuse charCount forever
        return res;
    }

    // draw the title and game info at the top
    method void drawTitle() {
        do Output.moveCursor(1, 5);
        // print "WORDLE"
        do Output.printChar(87);  // W
        do Output.printChar(79);  // O
        do Output.printChar(82);  // R
        do Output.printChar(68);  // D
        do Output.printChar(76);  // L
        do Output.printChar(69);  // E
        // show level info on the top right
        do Output.moveCursor(1, 50);
        do Output.printChar(76);  // L
        do Output.printChar(101); // e
        do Output.printChar(118); // v
        do Output.printChar(101); // e
        do Output.printChar(108); // l
        do Output.printChar(58);  // :
        do Output.printChar(32);  // space
        do Output.printInt(level + 1);
        do Output.printChar(47);
        do Output.printInt(LEVEL_COUNT);
        return;
    }

    // draw empty grid cells at the start of a level
    method void drawEmptyGrid() {
        var int r;
        var int c;

        let r = 0;
        while (r < ROWS) {
            let c = 0;
            while (c < WORD_LEN) {
                do drawCell(r, c, 0, 32);  // draw blank cell
                let c = c + 1;
            }
            let r = r + 1;
        }
        return;
    }

    // draw a complete row of guessed letters with correctness indicators
    method void drawRow(int r, Array g, Array res) {
        var int c;
        var int ch;

        let c = 0;
        while (c < WORD_LEN) {
            let ch = g[c];
            // draw each cell with letter and correctness status
            do drawCell(r, c, res[c], ch);
            let c = c + 1;
        }
        return;
    }

    // draw a single cell with letter and correctness marking
    method void drawCell(int r, int c, int s, int ch) {
        var int x1;
        var int y1;
        var int x2;
        var int y2;
        var int bx;
        var int by;

        // calculate cell coordinates
        let x1 = GRID_X + (c * (CELL_W + 8));
        let y1 = GRID_Y + (r * (CELL_H + 8));
        let x2 = x1 + CELL_W;
        let y2 = y1 + CELL_H;

        // draw cell background and border
        do Screen.setColor(false);
        do Screen.drawRectangle(x1, y1, x2, y2);
        do Screen.setColor(true);
        // draw cell borders
        do Screen.drawLine(x1, y1, x2, y1);
        do Screen.drawLine(x1, y1, x1, y2);
        do Screen.drawLine(x2, y1, x2, y2);
        do Screen.drawLine(x1, y2, x2, y2);

        // draw correctness indicator (check for exact match, slash for wrong spot)
        if (s = 2) {
            // draw check mark for correct position
            do Screen.drawLine(x1 + 4, y2 - 10, x1 + (CELL_W / 2) - 2, y2 - 4);
            do Screen.drawLine(x1 + (CELL_W / 2) - 2, y2 - 4, x2 - 4, y1 + 6);
        }
        if (s = 1) {
            // draw slash for wrong position
            do Screen.drawLine(x1 + 3, y1 + 3, x2 - 3, y2 - 3);
        }

        // calculate character position with row-specific vertical adjustments
        let by = y1 + CELL_H - 5;
        if (r = 1) { let by = by + 27; }
        if (r = 2) { let by = by + 40; }
        if (r = 3) { let by = by + 70; }
        if (r = 4) { let by = by + 80; }
        if (r = 5) { let by = by + 100; }

        let bx = (x1 + x2) / 2;
        do drawCharAt(ch, by, bx);
        return;
    }

    // draw a character at a specific screen position
    method void drawCharAt(int ch, int py, int px) {
        var int rowC;
        var int colC;

        // convert pixel coordinates to character grid coordinates
        let rowC = py / 16;
        let colC = px / 8;
        do Output.moveCursor(rowC, colC);
        do Output.printChar(ch);
        return;
    }

    // display the guess prompt line showing current level and guess number
    method void renderPrompt(int len) {
        var int i;
        // display guess line with current input
        do Output.moveCursor(4 + (row * 2), 44);
        // print "Guess #"
        do Output.printChar(71);
        do Output.printChar(117);
        do Output.printChar(101);
        do Output.printChar(115);
        do Output.printChar(115);
        do Output.printChar(32);
        do Output.printChar(35);
        do Output.printInt(row + 1);
        do Output.printChar(58);
        do Output.printChar(32);

        // print characters from inputChars
        let i = 0;
        while (i < len) {
            do Output.printChar(inputChars[i]);
            let i = i + 1;
        }

        // clear trailing area in case characters were deleted
        do Output.printString("     ");
        return;
    }

    // move the text cursor out of view so it doesn't show on screen
    method void hideCursor() {
        do Output.moveCursor(0, 0);
        return;
    }

    // display win message showing the correct word
    method void drawWin(int r) {
        do Output.moveCursor(4 + (r * 2), 40);
        // Print "Win in "
        do Output.printChar(87);  // W
        do Output.printChar(105); // i
        do Output.printChar(110); // n
        do Output.printChar(32);  // space
        do Output.printChar(105); // i
        do Output.printChar(110); // n
        do Output.printChar(32);  // space
        do Output.printInt(r + 1);
        do Output.printChar(58);  // :
        do Output.printChar(32);  // space
        do Output.printString(secret);
        return;
    }

    // display loss message revealing the secret word
    method void drawLose() {
        do Output.moveCursor(4 + (row * 2), 40);
        // Print "Lost. Word: "
        do Output.printChar(76);  // L
        do Output.printChar(111); // o
        do Output.printChar(115); // s
        do Output.printChar(116); // t
        do Output.printChar(46);  // .
        do Output.printChar(32);  // space
        do Output.printChar(87);  // W
        do Output.printChar(111); // o
        do Output.printChar(114); // r
        do Output.printChar(100); // d
        do Output.printChar(58);  // :
        do Output.printChar(32);  // space
        do Output.printString(secret);
        return;
    }

    // show stats screen between levels with wins and losses
    method void showStatsScreen() {
        do Screen.clearScreen();
        do Output.moveCursor(5, 25);
        // Print "LEVEL COMPLETE"
        do Output.printChar(76);  // L
        do Output.printChar(69);  // E
        do Output.printChar(86);  // V
        do Output.printChar(69);  // E
        do Output.printChar(76);  // L
        do Output.printChar(32);  // space
        do Output.printChar(67);  // C
        do Output.printChar(79);  // O
        do Output.printChar(77);  // M
        do Output.printChar(80);  // P
        do Output.printChar(76);  // L
        do Output.printChar(69);  // E
        do Output.printChar(84);  // T
        do Output.printChar(69);  // E

        do Output.moveCursor(8, 20);
        // Print "Wins: "
        do Output.printChar(87);  // W
        do Output.printChar(105); // i
        do Output.printChar(110); // n
        do Output.printChar(115); // s
        do Output.printChar(58);  // :
        do Output.printChar(32);  // space
        do Output.printInt(wins);

        do Output.moveCursor(10, 20);
        // Print "Losses: "
        do Output.printChar(76);  // L
        do Output.printChar(111); // o
        do Output.printChar(115); // s
        do Output.printChar(115); // s
        do Output.printChar(101); // e
        do Output.printChar(115); // s
        do Output.printChar(58);  // :
        do Output.printChar(32);  // space
        do Output.printInt(losses);

        do Output.moveCursor(13, 15);
        // Print "Press any key to continue..."
        do Output.printChar(80);  // P
        do Output.printChar(114); // r
        do Output.printChar(101); // e
        do Output.printChar(115); // s
        do Output.printChar(115); // s
        do Output.printChar(32);  // space
        do Output.printChar(97);  // a
        do Output.printChar(110); // n
        do Output.printChar(121); // y
        do Output.printChar(32);  // space
        do Output.printChar(107); // k
        do Output.printChar(101); // e
        do Output.printChar(121); // y
        do Output.printChar(32);  // space
        do Output.printChar(116); // t
        do Output.printChar(111); // o
        do Output.printChar(32);  // space
        do Output.printChar(99);  // c
        do Output.printChar(111); // o
        do Output.printChar(110); // n
        do Output.printChar(116); // t
        do Output.printChar(105); // i
        do Output.printChar(110); // n
        do Output.printChar(117); // u
        do Output.printChar(101); // e
        do Output.printChar(46);  // .
        do Output.printChar(46);  // .
        do Output.printChar(46);  // .

        do Keyboard.readChar();
        return;
    }

    // show final game over screen and ask if player wants to restart
    method boolean endPrompt() {
        var int key;
        do Screen.clearScreen();

        do Output.moveCursor(5, 25);
        // print "GAME OVER!"
        do Output.printChar(71);  // G
        do Output.printChar(65);  // A
        do Output.printChar(77);  // M
        do Output.printChar(69);  // E
        do Output.printChar(32);  // space
        do Output.printChar(79);  // O
        do Output.printChar(86);  // V
        do Output.printChar(69);  // E
        do Output.printChar(82);  // R
        do Output.printChar(33);  // !

        do Output.moveCursor(8, 23);
        // print "Final Wins: "
        do Output.printChar(70);  // F
        do Output.printChar(105); // i
        do Output.printChar(110); // n
        do Output.printChar(97);  // a
        do Output.printChar(108); // l
        do Output.printChar(32);  // space
        do Output.printChar(87);  // W
        do Output.printChar(105); // i
        do Output.printChar(110); // n
        do Output.printChar(115); // s
        do Output.printChar(58);  // :
        do Output.printChar(32);  // space
        do Output.printInt(wins);

        do Output.moveCursor(10, 23);
        // print "Final Losses: "
        do Output.printChar(70);  // F
        do Output.printChar(105); // i
        do Output.printChar(110); // n
        do Output.printChar(97);  // a
        do Output.printChar(108); // l
        do Output.printChar(32);  // space
        do Output.printChar(76);  // L
        do Output.printChar(111); // o
        do Output.printChar(115); // s
        do Output.printChar(115); // s
        do Output.printChar(101); // e
        do Output.printChar(115); // s
        do Output.printChar(58);  // :
        do Output.printChar(32);  // space
        do Output.printInt(losses);

        do Output.moveCursor(13, 20);
        // print "Press any key to exit"
        do Output.printChar(80);  // P
        do Output.printChar(114); // r
        do Output.printChar(101); // e
        do Output.printChar(115); // s
        do Output.printChar(115); // s
        do Output.printChar(32);  // space
        do Output.printChar(97);  // a
        do Output.printChar(110); // n
        do Output.printChar(121); // y
        do Output.printChar(32);  // space
        do Output.printChar(107); // k
        do Output.printChar(101); // e
        do Output.printChar(121); // y
        do Output.printChar(32);  // space
        do Output.printChar(116); // t
        do Output.printChar(111); // o
        do Output.printChar(32);  // space
        do Output.printChar(101); // e
        do Output.printChar(120); // x
        do Output.printChar(105); // i
        do Output.printChar(116); // t

        let key = Keyboard.readChar();
        // always exit after level 10
        return false;
    }
}