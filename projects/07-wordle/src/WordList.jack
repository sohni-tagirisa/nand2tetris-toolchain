// By Sohni Tagirisa
// handles word list management and intro screen - MINIMAL MEMORY VERSION
class WordList {
    // tracks if intro has been shown to avoid showing it multiple times
    static int INTRO_SHOWN;
    static String tempString;

    // returns the word at the given index - builds string on demand
    function String get(int i) {
        var int j;

        // initialize temp string if needed
        if (tempString = null) {
            let tempString = String.new(5);
        }

        // clear temp string
        while (tempString.length() > 0) {
            do tempString.eraseLastChar();
        }

        // build the appropriate word
        if (i = 0) {
            // APPLE
            do tempString.appendChar(65);
            do tempString.appendChar(80);
            do tempString.appendChar(80);
            do tempString.appendChar(76);
            do tempString.appendChar(69);
        }
        if (i = 1) {
            // ROBOT
            do tempString.appendChar(82);
            do tempString.appendChar(79);
            do tempString.appendChar(66);
            do tempString.appendChar(79);
            do tempString.appendChar(84);
        }
        if (i = 2) {
            // LASER
            do tempString.appendChar(76);
            do tempString.appendChar(65);
            do tempString.appendChar(83);
            do tempString.appendChar(69);
            do tempString.appendChar(82);
        }
        if (i = 3) {
            // BRAIN
            do tempString.appendChar(66);
            do tempString.appendChar(82);
            do tempString.appendChar(65);
            do tempString.appendChar(73);
            do tempString.appendChar(78);
        }
        if (i = 4) {
            // WATER
            do tempString.appendChar(87);
            do tempString.appendChar(65);
            do tempString.appendChar(84);
            do tempString.appendChar(69);
            do tempString.appendChar(82);
        }
        if (i = 5) {
            // CABLE
            do tempString.appendChar(67);
            do tempString.appendChar(65);
            do tempString.appendChar(66);
            do tempString.appendChar(76);
            do tempString.appendChar(69);
        }
        if (i = 6) {
            // MOTOR
            do tempString.appendChar(77);
            do tempString.appendChar(79);
            do tempString.appendChar(84);
            do tempString.appendChar(79);
            do tempString.appendChar(82);
        }
        if (i = 7) {
            // PIXEL
            do tempString.appendChar(80);
            do tempString.appendChar(73);
            do tempString.appendChar(88);
            do tempString.appendChar(69);
            do tempString.appendChar(76);
        }

        return tempString;
    }

    // returns total number of words available (7 levels)
    function int size() { return 7; }

